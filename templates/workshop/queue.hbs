            {{/if}}
            {{#if deconstruct}}
            {{#with deconstruct}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.Heading"}}</h4>
            <p class="detail-variant-line">{{localize "pf2e-artisans-workshop.Variant.Deconstruct.Purpose" purpose=purpose}}{{#if similarNote}} · {{similarNote}}{{/if}}</p>
            {{#if followOn}}<p class="detail-variant-line">{{#if followOn.name}}{{localize "pf2e-artisans-workshop.Variant.Deconstruct.FollowOn" name=followOn.name}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Deconstruct.NoFollowOn"}}{{/if}}</p>{{/if}}
            <p class="detail-variant-line">{{#if workshop.on}}<i class="fa-solid fa-check" inert></i> {{localize "pf2e-artisans-workshop.Variant.Deconstruct.WorkshopOn"}}{{else}}<i class="fa-solid fa-xmark" inert></i> {{localize "pf2e-artisans-workshop.Variant.Deconstruct.WorkshopOff"}}{{/if}}</p>
            {{#if damaged}}<p class="detail-variant-line warning"><i class="fa-solid fa-heart-crack" inert></i> {{damaged}}</p>{{/if}}
            {{#if loss}}<p class="detail-variant-line">{{loss}}</p>{{/if}}
            {{#if result}}<p class="detail-variant-line"><i class="fa-solid fa-cubes" inert></i> {{result}}</p>{{/if}}
            <div class="detail-actions">
                {{#if canPurpose}}<button type="button" data-action="variant" data-op="purpose"><i class="fa-solid fa-hammer" inert></i>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.PurposeTitle"}}</button>{{/if}}
