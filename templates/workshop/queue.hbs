<section class="tab workshop-queue {{tab.cssClass}}" data-group="primary" data-tab="queue" role="tabpanel"
         id="pf2e-artisans-workshop-panel-queue" aria-labelledby="pf2e-artisans-workshop-tab-queue">
    {{#if readable}}
    <div class="queue-toolbar" role="group" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Filters'}}">
        <select data-filter="scope" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Filter.Scope'}}">
            {{#each scopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
        </select>
        <select data-filter="status" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Filter.Status'}}">
            {{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{localize label}}</option>{{/each}}
        </select>
        <select data-filter="crafter" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Filter.Crafter'}}">
            {{#each crafterOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if name}}{{name}}{{else}}{{localize label}}{{/if}}</option>{{/each}}
        </select>
        <select data-filter="recipient" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Filter.Recipient'}}">
            {{#each recipientOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if name}}{{name}}{{else}}{{localize label}}{{/if}}</option>{{/each}}
        </select>
        <input type="search" data-filter="search" value="{{filters.search}}" placeholder="{{localize 'pf2e-artisans-workshop.Queue.Search'}}"
               aria-label="{{localize 'pf2e-artisans-workshop.Queue.SearchLabel'}}">
        {{#if filtered}}
        <button type="button" class="clear" data-action="clearFilters" data-tooltip="{{localize 'pf2e-artisans-workshop.Queue.ClearFilters'}}"
                aria-label="{{localize 'pf2e-artisans-workshop.Queue.ClearFilters'}}"><i class="fa-solid fa-filter-circle-xmark" inert></i></button>
        {{/if}}
        <button type="button" class="find-item" data-action="findItem" {{#unless ready}}disabled{{/unless}}
                aria-label="{{localize 'pf2e-artisans-workshop.Queue.FindItem'}}" data-tooltip="{{localize 'pf2e-artisans-workshop.Queue.FindItem'}}">
            <i class="fa-solid fa-magnifying-glass" inert></i>
        </button>
        <button type="button" class="request primary" data-action="request" {{#unless ready}}disabled{{/unless}}>
            <i class="fa-solid fa-plus" inert></i><span>{{localize "pf2e-artisans-workshop.Queue.Request"}}</span>
        </button>
    </div>
    <p class="queue-summary">{{localize "pf2e-artisans-workshop.Queue.Summary" open=summary.open requested=summary.requested working=summary.working complete=summary.complete}}</p>
    <div class="queue-body{{#if selected}} has-detail{{/if}}">
        <div class="queue-main">
            {{#if orders.length}}
            <ol class="order-list" aria-label="{{localize 'pf2e-artisans-workshop.Queue.Orders'}}">
                {{#each orders}}
                <li class="order-row status-{{status}}{{#if mine}} mine{{/if}}{{#if blocked.length}} blocked{{/if}}{{#if (eq id ../selected.id)}} selected{{/if}}"
                    data-order-id="{{id}}" tabindex="{{#if tabStop}}0{{else}}-1{{/if}}"
                    aria-label="{{localize 'pf2e-artisans-workshop.Queue.RowLabel' no=no name=title status=statusWord}}">
                    <div class="order-line">
                        <span class="order-no">{{localize "pf2e-artisans-workshop.Queue.Number" no=no}}</span>
                        {{#if img}}<img class="order-img" src="{{img}}" alt="">{{else}}<i class="order-img fa-solid fa-gift" inert></i>{{/if}}
                        {{#if kindText}}<span class="order-kind">{{kindText}}</span>{{/if}}
                        <span class="order-title">{{title}}</span>
                        {{#if targetText}}<span class="order-target"><i class="fa-solid fa-crosshairs" inert></i> {{targetText}}</span>{{/if}}
                        {{#if quantityText}}<span class="order-qty">{{quantityText}}</span>{{/if}}
                        <span class="order-for"><i class="fa-solid fa-arrow-right" inert></i> {{forText}}</span>
                        {{#unless giftHidden}}<span class="tags paizo-style"><span class="tag rarity {{rarity}}">{{rarityLabel}}</span></span>{{/unless}}
                        <span class="order-crafter">{{#if crafter}}{{localize "pf2e-artisans-workshop.Queue.Crafter" name=crafter}}{{else}}{{localize "pf2e-artisans-workshop.Queue.NoCrafter"}}{{/if}}</span>
                    </div>
                    <div class="order-state">
                        {{> "modules/pf2e-artisans-workshop/templates/partials/status.hbs"}}
                        {{> "modules/pf2e-artisans-workshop/templates/partials/progress.hbs"}}
                        <span class="order-numbers">
                            {{#if (eq progress.phase "funding")}}{{localize "pf2e-artisans-workshop.Queue.Funding" escrow=escrowText upfront=upfrontText}}
                            {{else if (eq progress.phase "crafting")}}{{localize "pf2e-artisans-workshop.Queue.Left" left=finishText}}
                            {{else}}{{localize "pf2e-artisans-workshop.Queue.PaidInFull" price=priceText}}{{/if}}
                        </span>
                        {{#if daysText}}<span class="order-days">{{daysText}}</span>{{/if}}
                    </div>
                    <div class="order-facts">
                        {{#if routeText}}<span class="fact">{{localize "pf2e-artisans-workshop.Queue.Route" route=routeText}}</span>{{/if}}
                        {{#if dc}}<span class="fact">{{localize "pf2e-artisans-workshop.Queue.Dc" dc=dc}}</span>{{/if}}
                        {{#if perDayText}}{{#unless isClosed}}<span class="fact">{{localize "pf2e-artisans-workshop.Queue.PerDay" amount=perDayText}}</span>{{/unless}}{{/if}}
                        {{#if checkText}}<span class="fact degree {{checkClass}}">{{localize "pf2e-artisans-workshop.Queue.Check" degree=checkText}}</span>{{/if}}
                        {{#if conflictText}}<span class="fact conflict"><i class="fa-solid fa-code-compare" inert></i> {{localize "pf2e-artisans-workshop.Queue.Conflict" degree=conflictText}}</span>{{/if}}
                        {{#each blockedText}}<span class="blocker"><i class="fa-solid fa-lock" inert></i> {{this}}</span>{{/each}}
                        {{#if deliveryText}}<span class="fact delivery delivery-{{deliveryState}}"><i class="fa-solid fa-box-open" inert></i> {{deliveryText}}</span>{{/if}}
                    </div>
                    <div class="order-actions">
                        {{#if actions.accept}}<button type="button" data-action="op" data-op="accept"><i class="fa-solid fa-handshake" inert></i>{{localize "pf2e-artisans-workshop.Action.Accept"}}</button>{{/if}}
                        {{#if actions.start}}<button type="button" data-action="op" data-op="start" {{#unless actions.startReady}}disabled{{/unless}}><i class="fa-solid fa-play" inert></i>{{localize "pf2e-artisans-workshop.Action.Start"}}</button>{{/if}}
                        {{#if actions.work}}<button type="button" data-action="op" data-op="work"><i class="fa-solid fa-calendar-plus" inert></i>{{localize "pf2e-artisans-workshop.Action.Work"}}</button>{{/if}}
                        {{#if actions.roll}}<button type="button" data-action="op" data-op="roll"><i class="fa-solid fa-dice-d20" inert></i>{{localize "pf2e-artisans-workshop.Action.Roll"}}</button>{{/if}}
                        {{#if actions.settle}}<button type="button" data-action="op" data-op="settle"><i class="fa-solid fa-scale-balanced" inert></i>{{localize "pf2e-artisans-workshop.Action.Settle"}}</button>{{/if}}
                        {{#if actions.finish}}<button type="button" class="primary" data-action="op" data-op="finish"><i class="fa-solid fa-flag-checkered" inert></i>{{localize "pf2e-artisans-workshop.Action.Finish" amount=finishText}}</button>{{/if}}
                        {{#if actions.resume}}<button type="button" data-action="op" data-op="resume"><i class="fa-solid fa-play" inert></i>{{localize "pf2e-artisans-workshop.Action.Resume"}}</button>{{/if}}
                        {{#if actions.retry}}<button type="button" data-action="op" data-op="retry"><i class="fa-solid fa-rotate-right" inert></i>{{localize "pf2e-artisans-workshop.Action.Retry"}}</button>{{/if}}
                        {{#if actions.fund}}<button type="button" data-action="fund"{{#if shortCp}} data-fill="short"{{/if}}><i class="fa-solid fa-coins" inert></i>{{localize "pf2e-artisans-workshop.Action.Fund"}}</button>{{/if}}
                        {{#if canCollect}}<button type="button" class="primary" data-action="take"><i class="fa-solid fa-hand-holding" inert></i>{{localize "pf2e-artisans-workshop.Action.Collect"}}</button>{{/if}}
                        <button type="button" data-action="select"><i class="fa-solid fa-up-right-from-square" inert></i>{{localize "pf2e-artisans-workshop.Action.Open"}}</button>
                    </div>
                </li>
                {{/each}}
            </ol>
            {{else}}
            <p class="queue-empty">{{#if total}}{{localize "pf2e-artisans-workshop.Queue.NoMatch"}}{{else}}{{localize "pf2e-artisans-workshop.Queue.Empty"}}{{/if}}</p>
            {{/if}}
            <p class="drop-hint"><i class="fa-solid fa-hand-pointer" inert></i> {{localize "pf2e-artisans-workshop.Queue.DropHint"}}</p>
            {{#if services.length}}
            <h3 class="services-heading">{{localize "pf2e-artisans-workshop.Service.Heading"}}</h3>
            <ul class="service-list" aria-label="{{localize 'pf2e-artisans-workshop.Service.Heading'}}">
                {{#each services}}
                <li class="service-row status-{{status}}" data-service-id="{{id}}">
                    <div class="order-line">
                        <span class="status-chip status-{{status}}"><i class="{{statusIcon}}" inert></i><span class="word">{{statusWord}}</span></span>
                        <span class="order-title">{{kind}}</span>
                        {{#if item}}<span class="order-target">{{item}}{{#if host}} <i class="fa-solid fa-arrow-right" inert></i> {{host}}{{/if}}</span>{{/if}}
                        <span class="order-for">{{localize "pf2e-artisans-workshop.Service.For" name=requester}}</span>
                        <span class="order-crafter">{{#if performer}}{{localize "pf2e-artisans-workshop.Service.By" name=performer}}{{else}}{{localize "pf2e-artisans-workshop.Service.NoPerformer"}}{{/if}}</span>
                    </div>
                    {{#if result}}<p class="service-result">{{result}}</p>{{/if}}
                    {{#if note}}<p class="detail-notes">{{note}}</p>{{/if}}
                    {{#unless closed}}
                    <div class="order-actions">
                        {{#if actions.offer}}<button type="button" data-action="service" data-op="offer"><i class="fa-solid fa-handshake" inert></i>{{localize "pf2e-artisans-workshop.Service.Offer"}}</button>{{/if}}
                        {{#if actions.handOver}}<button type="button" data-action="service" data-op="hand-over"><i class="fa-solid fa-box" inert></i>{{localize "pf2e-artisans-workshop.Custody.HandOver"}}</button>{{/if}}
                        {{#if actions.perform}}<button type="button" class="primary" data-action="service" data-op="perform"><i class="fa-solid fa-screwdriver-wrench" inert></i>{{localize "pf2e-artisans-workshop.Service.Perform"}}</button>{{/if}}
                        {{#if actions.cancel}}<button type="button" class="danger" data-action="service" data-op="cancel">{{localize "pf2e-artisans-workshop.Service.Cancel"}}</button>{{/if}}
                    </div>
                    {{/unless}}
                </li>
                {{/each}}
            </ul>
            {{/if}}
        </div>
        {{#if selected}}
        <aside class="order-detail" tabindex="-1" role="region" data-order-id="{{selected.id}}"
               aria-label="{{localize 'pf2e-artisans-workshop.Detail.Label' name=selected.title}}">
            {{#with selected}}
            <header class="detail-header">
                {{#if img}}<img src="{{img}}" alt="">{{/if}}
                <h3>{{title}}{{#if quantityText}} <span class="order-qty">{{quantityText}}</span>{{/if}}</h3>
                <button type="button" class="icon" data-action="closeDetail" aria-label="{{localize 'pf2e-artisans-workshop.Detail.Close'}}"
                        data-tooltip="{{localize 'pf2e-artisans-workshop.Detail.Close'}}"><i class="fa-solid fa-xmark" inert></i></button>
            </header>
            <div class="detail-state">
                {{> "modules/pf2e-artisans-workshop/templates/partials/status.hbs"}}
                {{> "modules/pf2e-artisans-workshop/templates/partials/progress.hbs"}}
                <p class="detail-progress">{{progressText}}</p>
                {{#if daysText}}<p>{{daysText}}</p>{{/if}}
            </div>
            <dl class="detail-facts">
                {{#if extras.kind}}<dt>{{localize "pf2e-artisans-workshop.Detail.Kind"}}</dt><dd>{{extras.kind}}</dd>{{/if}}
                {{#if extras.target}}<dt>{{localize "pf2e-artisans-workshop.Detail.Target"}}</dt><dd>{{extras.target}}</dd>{{/if}}
                <dt>{{localize "pf2e-artisans-workshop.Detail.Requester"}}</dt><dd>{{requesterName}}</dd>
                <dt>{{localize "pf2e-artisans-workshop.Detail.For"}}</dt><dd>{{forText}}</dd>
                <dt>{{localize "pf2e-artisans-workshop.Detail.Crafter"}}</dt><dd>{{#if crafter}}{{crafter}}{{else}}{{localize "pf2e-artisans-workshop.Queue.NoCrafter"}}{{/if}}</dd>
                <dt>{{localize "pf2e-artisans-workshop.Detail.Price"}}</dt><dd>{{priceText}}</dd>
                <dt>{{localize "pf2e-artisans-workshop.Detail.Upfront"}}</dt><dd>{{upfrontText}}</dd>
                <dt>{{localize "pf2e-artisans-workshop.Detail.Escrow"}}</dt><dd>{{escrowText}}</dd>
                {{#if routeText}}<dt>{{localize "pf2e-artisans-workshop.Detail.Route"}}</dt><dd>{{routeText}}</dd>{{/if}}
                {{#if dc}}<dt>{{localize "pf2e-artisans-workshop.Detail.Dc"}}</dt><dd>{{dc}}</dd>{{/if}}
                {{#if setup}}<dt>{{localize "pf2e-artisans-workshop.Detail.Setup"}}</dt><dd>{{localize "pf2e-artisans-workshop.Detail.SetupDays" done=setup.done days=setup.days}}</dd>{{/if}}
                {{#if checkText}}<dt>{{localize "pf2e-artisans-workshop.Detail.Check"}}</dt><dd class="degree {{checkClass}}">{{checkText}}</dd>{{/if}}
                {{#if perDayText}}<dt>{{localize "pf2e-artisans-workshop.Detail.PerDay"}}</dt><dd>{{perDayText}}</dd>{{/if}}
                {{#unless isClosed}}<dt>{{localize finishLabel}}</dt><dd>{{finishText}}</dd>{{/unless}}
            </dl>
            {{#if conflictText}}
            <p class="detail-conflict"><i class="fa-solid fa-code-compare" inert></i> {{localize "pf2e-artisans-workshop.Detail.Conflict" degree=conflictText}}</p>
            {{/if}}
            {{#if shortText}}<p class="detail-short"><i class="fa-solid fa-coins" inert></i> {{shortText}}</p>{{/if}}
            {{#if requirementsText}}
            <section class="detail-requirements" aria-label="{{localize 'pf2e-artisans-workshop.Detail.Gates'}}">
                <h4>{{localize "pf2e-artisans-workshop.Detail.Gates"}}</h4>
                {{#if requirementsText.unmet.length}}
                <ul class="detail-gates unmet">
                    {{#each requirementsText.unmet}}
                    <li class="fail">
                        <i class="fa-solid fa-xmark" inert></i>
                        <span class="gate-name">{{name}}</span>
                        <span class="gate-why">{{text}}</span>
                        {{!-- data-op tells this button from the actions' Fund button, so focus comes back to the right one --}}
                        {{#if (eq action "fund")}}{{#if ../actions.fund}}<button type="button" class="small primary" data-action="fund" data-op="fund-short" data-fill="short"><i class="fa-solid fa-coins" inert></i>{{localize "pf2e-artisans-workshop.Action.FundIt"}}</button>{{/if}}{{/if}}
                        {{!-- M5 on M4.1: the fix for precious stock, castings and an item to hand over; data-fix tells each from the same button below --}}
                        {{#if (eq action "stock")}}{{#if ../extras.stock}}<button type="button" class="small primary" data-action="custody" data-op="stock" data-fix="requirement"><i class="fa-solid fa-cubes" inert></i>{{localize "pf2e-artisans-workshop.Custody.AddStock"}}</button>{{/if}}{{/if}}
                        {{#if (eq action "castings")}}{{#if ../extras.supply.canPledge}}<button type="button" class="small primary" data-action="pledgeOp" data-op="pledge" data-fix="requirement"><i class="fa-solid fa-scroll" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Pledge"}}</button>{{/if}}{{#if ../extras.supply.canBuy}}<button type="button" class="small" data-action="pledgeOp" data-op="buy" data-fix="requirement"><i class="fa-solid fa-coins" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Buy"}}</button>{{/if}}{{/if}}
                        {{#if (eq action "hand-over")}}{{#each ../extras.handOver}}<button type="button" class="small primary" data-action="custody" data-op="hand-over" data-item="{{uuid}}" data-purpose="{{purpose}}" data-fix="requirement"><i class="fa-solid fa-box" inert></i>{{localize "pf2e-artisans-workshop.Custody.HandOverItem" name=name}}</button>{{/each}}{{/if}}
                    </li>
                    {{/each}}
                </ul>
                {{/if}}
                {{#if requirementsText.metList.length}}
                <details class="detail-met"{{#if metOpen}} open{{/if}}>
                    <summary data-toggle="met"><i class="fa-solid fa-check" inert></i> {{requirementsText.countText}}</summary>
                    <ul class="detail-gates">
                        {{#each requirementsText.metList}}<li class="ok"><i class="fa-solid fa-check" inert></i><span class="gate-name">{{name}}</span></li>{{/each}}
                    </ul>
                </details>
                {{/if}}
            </section>
            {{/if}}
            <div class="detail-actions">
                {{#if actions.accept}}<button type="button" data-action="op" data-op="accept">{{localize "pf2e-artisans-workshop.Action.Accept"}}</button>{{/if}}
                {{#if actions.release}}<button type="button" data-action="op" data-op="release">{{localize "pf2e-artisans-workshop.Action.Release"}}</button>{{/if}}
                {{#if actions.start}}<button type="button" data-action="op" data-op="start" {{#unless actions.startReady}}disabled{{/unless}}>{{localize "pf2e-artisans-workshop.Action.Start"}}</button>{{/if}}
                {{#if actions.work}}<button type="button" data-action="op" data-op="work">{{localize "pf2e-artisans-workshop.Action.Work"}}</button>{{/if}}
                {{#if actions.roll}}<button type="button" data-action="op" data-op="roll">{{localize "pf2e-artisans-workshop.Action.Roll"}}</button>{{/if}}
                {{#if actions.settle}}<button type="button" data-action="op" data-op="settle">{{localize "pf2e-artisans-workshop.Action.Settle"}}</button>{{/if}}
                {{#if actions.finish}}<button type="button" class="primary" data-action="op" data-op="finish">{{localize "pf2e-artisans-workshop.Action.Finish" amount=finishText}}</button>{{/if}}
                {{#if actions.pause}}<button type="button" data-action="op" data-op="pause">{{localize "pf2e-artisans-workshop.Action.Pause"}}</button>{{/if}}
                {{#if actions.resume}}<button type="button" data-action="op" data-op="resume">{{localize "pf2e-artisans-workshop.Action.Resume"}}</button>{{/if}}
                {{#if actions.retry}}<button type="button" data-action="op" data-op="retry">{{localize "pf2e-artisans-workshop.Action.Retry"}}</button>{{/if}}
                {{#if actions.fund}}<button type="button" data-action="fund"{{#if shortCp}} data-fill="short"{{/if}}>{{localize "pf2e-artisans-workshop.Action.Fund"}}</button>{{/if}}
                {{#if actions.withdraw}}<button type="button" data-action="withdraw">{{localize "pf2e-artisans-workshop.Action.Withdraw" amount=withdrawText}}</button>{{/if}}
                {{#if actions.returnToFund}}<button type="button" data-action="returnToFund">{{localize "pf2e-artisans-workshop.Action.ReturnToFund" amount=fundReturnText}}</button>{{/if}}
                {{#if canCollect}}<button type="button" class="primary" data-action="take">{{localize "pf2e-artisans-workshop.Action.Collect"}}</button>{{/if}}
                {{#if actions.undo}}<button type="button" data-action="op" data-op="undo">{{localize "pf2e-artisans-workshop.Action.Undo"}}</button>{{/if}}
                {{#if actions.cancel}}<button type="button" class="danger" data-action="op" data-op="cancel">{{localize "pf2e-artisans-workshop.Action.Cancel"}}</button>{{/if}}
            </div>
            {{#if costText}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Cost"}}</h4>
            <p class="detail-cost">{{costText.summary}}</p>
            {{#if costText.ruined}}<p class="detail-cost">{{costText.ruined}}</p>{{/if}}
            {{#if costText.stock}}<p class="detail-cost">{{costText.stock}}</p>{{/if}}
            {{#if costText.bought}}<p class="detail-cost">{{costText.bought}}</p>{{/if}}
            {{/if}}
            {{#if deliveryText}}<p class="detail-delivery delivery-{{deliveryState}}"><i class="fa-solid fa-box-open" inert></i> {{deliveryText}}</p>{{/if}}
            {{#with extras}}
            {{#if supply}}
            <h4>{{localize "pf2e-artisans-workshop.Pledge.Heading"}}</h4>
            <p class="detail-supply">{{supply.text}}</p>
            {{#if pledges.length}}
            <ul class="detail-list detail-pledges">
                {{#each pledges}}
                <li class="pledge-{{statusKey}}" data-op-row="{{id}}">
                    <span>{{localize "pf2e-artisans-workshop.Pledge.Line" caster=caster spell=spell rank=rank castings=castings}}</span>
                    <span class="by">{{status}}{{#if cost}} {{cost}}{{/if}}</span>
                    {{#if canFulfil}}<button type="button" class="small" data-action="pledgeOp" data-op="fulfil" data-pledge="{{id}}"{{#if askCost}} data-cost="ask"{{/if}}>{{localize "pf2e-artisans-workshop.Pledge.Fulfil"}}</button>{{/if}}
                    {{#if canWithdraw}}<button type="button" class="small" data-action="pledgeOp" data-op="withdraw" data-pledge="{{id}}">{{localize "pf2e-artisans-workshop.Pledge.Withdraw"}}</button>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{/if}}
            <div class="detail-actions">
                {{#if supply.canPledge}}<button type="button" data-action="pledgeOp" data-op="pledge"><i class="fa-solid fa-scroll" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Pledge"}}</button>{{/if}}
                {{#if supply.canBuy}}<button type="button" data-action="pledgeOp" data-op="buy"><i class="fa-solid fa-coins" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Buy"}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if (or custody.length handOver.length)}}
            <h4>{{localize "pf2e-artisans-workshop.Custody.Heading"}}</h4>
            <ul class="detail-list detail-custody">
                {{#each custody}}
                <li><span>{{localize "pf2e-artisans-workshop.Custody.Line" name=name purpose=purpose from=from}}</span>{{#if value}}<span class="money">{{value}}</span>{{/if}}
                    {{#if canGiveBack}}<button type="button" class="small" data-action="custody" data-op="give-back" data-line="{{id}}">{{localize "pf2e-artisans-workshop.Custody.GiveBack"}}</button>{{/if}}</li>
                {{/each}}
                {{#each handOver}}
                <li><span>{{localize "pf2e-artisans-workshop.Custody.Waiting" name=name purpose=purposeText}}</span>
                    <button type="button" class="small" data-action="custody" data-op="hand-over" data-item="{{uuid}}" data-purpose="{{purpose}}">{{localize "pf2e-artisans-workshop.Custody.HandOver"}}</button></li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if stock}}
            <div class="detail-actions"><button type="button" data-action="custody" data-op="stock"><i class="fa-solid fa-cubes" inert></i>{{localize "pf2e-artisans-workshop.Custody.AddStock"}}</button></div>
            {{/if}}
            {{/with}}
            {{#if (or contributorsText.length stockText.length)}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Contributors"}}</h4>
            <ul class="detail-list">
                {{#each contributorsText}}<li><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
                {{#each stockText}}<li class="stock"><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if spentText.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Spent"}}</h4>
            <ul class="detail-list">
                {{#each spentText}}<li><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if showWorkRule}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.WorkDays"}}</h4>
            <p class="hint detail-work-rule">{{localize "pf2e-artisans-workshop.Detail.WorkRule"}}</p>
            {{/if}}
            {{#if workDaysText.length}}
            {{#unless showWorkRule}}<h4>{{localize "pf2e-artisans-workshop.Detail.WorkDays"}}</h4>{{/unless}}
            <ol class="detail-list detail-days">
                {{#each workDaysText}}<li>{{this}}</li>{{/each}}
            </ol>
            {{/if}}
            {{#if notes}}<h4>{{localize "pf2e-artisans-workshop.Detail.Notes"}}</h4><p class="detail-notes">{{notes}}</p>{{/if}}
            {{#if history.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.History"}}</h4>
            <ul class="detail-list">
                {{#each history}}<li><span>{{localize eventLabel}}</span><span class="by">{{localize "pf2e-artisans-workshop.Common.ByWhen" by=by when=when}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if rows.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Rows"}}</h4>
            <ul class="detail-list">
                {{#each rows}}<li class="{{#if reversed}}reversed{{/if}}"><span>{{localize kind}}{{#if actor}} {{localize "pf2e-artisans-workshop.Common.For" name=actor}}{{/if}}</span>{{#if amount}}<span class="money">{{amount}}</span>{{/if}}<span class="by">{{localize "pf2e-artisans-workshop.Common.By" by=by}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{/with}}
        </aside>
        {{/if}}
    </div>
    {{else}}
    <p class="queue-empty">{{localize "pf2e-artisans-workshop.Window.Unavailable"}}</p>
    {{/if}}
</section>
