                <li><span>{{localize "pf2e-artisans-workshop.Custody.Line" name=name purpose=purpose from=from}}</span>{{#if value}}<span class="money">{{value}}</span>{{/if}}
                    {{#if canGiveBack}}<button type="button" class="small" data-action="custody" data-op="give-back" data-line="{{id}}">{{localize "pf2e-artisans-workshop.Custody.GiveBack"}}</button>{{/if}}</li>
                {{/each}}
                {{#each handOver}}
                <li><span>{{localize "pf2e-artisans-workshop.Custody.Waiting" name=name purpose=purposeText}}</span>
                    <button type="button" class="small" data-action="custody" data-op="hand-over" data-item="{{uuid}}" data-purpose="{{purpose}}">{{localize "pf2e-artisans-workshop.Custody.HandOver"}}</button></li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if stock}}
            <div class="detail-actions"><button type="button" data-action="custody" data-op="stock"><i class="fa-solid fa-cubes" inert></i>{{localize "pf2e-artisans-workshop.Custody.AddStock"}}</button></div>
            {{/if}}
            {{!-- M9a (6.16): what the Treasure Vault (Remastered) variants that are on add to the order --}}
            {{#if variants}}
            {{#with variants}}
            <section class="detail-variants" aria-label="{{localize 'pf2e-artisans-workshop.Variant.Heading'}}">
            {{#if complex}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Rush.Heading"}}</h4>
            {{#each complex.lines}}<p class="detail-variant-line">{{this}}</p>{{/each}}
            {{#if complex.flat}}<p class="detail-variant-line"><i class="fa-solid fa-dice-d20" inert></i> {{complex.flat}}</p>{{/if}}
            {{#if complex.rushFinish}}{{#if complex.rushFinish.on}}<p class="hint">{{localize "pf2e-artisans-workshop.Variant.Rush.Rushing"}}</p>{{/if}}{{/if}}
            <div class="detail-actions">
                {{#if complex.rush.can}}<button type="button" data-action="variant" data-op="rush"><i class="fa-solid fa-gauge-high" inert></i>{{localize "pf2e-artisans-workshop.Variant.Rush.Choose"}}</button>{{/if}}
                {{#if complex.setUpNow}}<button type="button" class="primary" data-action="variant" data-op="setup-now"><i class="fa-solid fa-stopwatch" inert></i>{{localize "pf2e-artisans-workshop.Variant.Rush.SetUpNow"}}</button>{{/if}}
                {{#if complex.rushFinish.can}}<button type="button" data-action="variant" data-op="rush-finish" aria-pressed="{{#if complex.rushFinish.on}}true{{else}}false{{/if}}"><i class="fa-solid fa-forward" inert></i>{{#if complex.rushFinish.on}}{{localize "pf2e-artisans-workshop.Variant.Rush.FinishOff"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Rush.FinishOn"}}{{/if}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if critical}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Critical.Heading"}}</h4>
            {{#if critical.special}}<p class="detail-variant-line">{{#if critical.special.on}}{{localize "pf2e-artisans-workshop.Variant.Critical.Special"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Critical.NotSpecial"}}{{/if}}</p>{{/if}}
            {{#if critical.secret}}<p class="detail-variant-line"><i class="fa-solid fa-eye-slash" inert></i> {{critical.secret.text}}</p>{{/if}}
            {{#if critical.pending}}<p class="hint">{{critical.pending}}</p>{{/if}}
            {{#with critical.record}}
            <p class="detail-variant-line critical-{{kind}}"><i class="fa-solid fa-star" inert></i> {{kindText}}{{#if natural}} · {{natural}}{{/if}} · {{mode}}</p>
            {{#if category}}<p class="detail-variant-line">{{category}}</p>{{/if}}
            {{#if note}}<p class="detail-notes">{{note}}</p>{{/if}}
            {{#if curse}}<p class="detail-variant-line"><i class="fa-solid fa-skull" inert></i> {{curse}}</p>{{/if}}
            {{/with}}
            <div class="detail-actions">
                {{#if critical.special.can}}<button type="button" data-action="variant" data-op="special" aria-pressed="{{#if critical.special.on}}true{{else}}false{{/if}}"><i class="fa-solid fa-gem" inert></i>{{#if critical.special.on}}{{localize "pf2e-artisans-workshop.Variant.Critical.Unmark"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Critical.Mark"}}{{/if}}</button>{{/if}}
                {{#if critical.secret.canReveal}}<button type="button" data-action="variant" data-op="reveal"><i class="fa-solid fa-eye" inert></i>{{localize "pf2e-artisans-workshop.Variant.Critical.Reveal"}}</button>{{/if}}
                {{#if critical.record.canRecord}}<button type="button" data-action="variant" data-op="critical"><i class="fa-solid fa-star" inert></i>{{localize "pf2e-artisans-workshop.Variant.Critical.Record"}}</button>{{/if}}
                {{#if critical.record.canCurse}}<button type="button" data-action="variant" data-op="curse"><i class="fa-solid fa-skull" inert></i>{{localize "pf2e-artisans-workshop.Variant.Critical.Curse"}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if events}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Event.Heading"}}</h4>
