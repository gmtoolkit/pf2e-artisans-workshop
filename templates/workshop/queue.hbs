                {{#if followOn.can}}<button type="button" data-action="variant" data-op="follow-on"><i class="fa-solid fa-link" inert></i>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.FollowOnTitle"}}</button>{{/if}}
                {{#if canRetryLoss}}<button type="button" data-action="variant" data-op="retry-loss"><i class="fa-solid fa-rotate-right" inert></i>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.RetryLoss"}}</button>{{/if}}
            </div>
            {{/with}}
            {{/if}}
            {{#if components}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.ComponentsHeading"}}</h4>
            {{#if components.lines.length}}
            <ul class="detail-list">{{#each components.lines}}<li><span>{{name}} · {{purpose}}</span><span class="money">{{credit}}</span></li>{{/each}}</ul>
            {{/if}}
            <p class="detail-variant-line">{{#if components.similar.on}}<i class="fa-solid fa-check" inert></i> {{localize "pf2e-artisans-workshop.Variant.Deconstruct.SimilarOn"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Deconstruct.SimilarOff"}}{{/if}}</p>
            <div class="detail-actions">
                {{#if components.canHandOver}}<button type="button" data-action="variant" data-op="components"><i class="fa-solid fa-cubes" inert></i>{{localize "pf2e-artisans-workshop.Variant.Deconstruct.UseComponents"}}</button>{{/if}}
                {{#if components.similar.can}}<button type="button" data-action="variant" data-op="checklist" data-key="similar" aria-pressed="{{#if components.similar.on}}true{{else}}false{{/if}}"><i class="fa-solid fa-equals" inert></i>{{#if components.similar.on}}{{localize "pf2e-artisans-workshop.Variant.Checklist.Unconfirm"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Deconstruct.ConfirmSimilar"}}{{/if}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if grow}}
            {{#with grow}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Grow.Heading"}}</h4>
            <p class="detail-variant-line">{{skill}}</p>
            <p class="detail-variant-line">{{#if tools.on}}<i class="fa-solid fa-check" inert></i> {{localize "pf2e-artisans-workshop.Variant.Grow.ToolsOn"}}{{else}}<i class="fa-solid fa-xmark" inert></i> {{localize "pf2e-artisans-workshop.Variant.Grow.ToolsOff"}}{{/if}}</p>
            {{#if untended}}<p class="detail-variant-line">{{#if untended.on}}{{localize "pf2e-artisans-workshop.Variant.Grow.Untended"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Grow.Tended"}}{{/if}}</p>{{/if}}
            {{#each seasons}}<p class="detail-variant-line">{{this}}</p>{{/each}}
            <div class="detail-actions">
                {{#if tools.can}}<button type="button" data-action="variant" data-op="checklist" data-key="grow-tools" aria-pressed="{{#if tools.on}}true{{else}}false{{/if}}"><i class="fa-solid fa-seedling" inert></i>{{#if tools.on}}{{localize "pf2e-artisans-workshop.Variant.Checklist.Unconfirm"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Grow.ConfirmTools"}}{{/if}}</button>{{/if}}
                {{#if untended.can}}<button type="button" data-action="variant" data-op="untended" aria-pressed="{{#if untended.on}}true{{else}}false{{/if}}"><i class="fa-solid fa-leaf" inert></i>{{#if untended.on}}{{localize "pf2e-artisans-workshop.Variant.Grow.Tend"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Grow.LeaveUntended"}}{{/if}}</button>{{/if}}
                {{#each due}}{{#if can}}<button type="button" class="primary" data-action="variant" data-op="season" data-season="{{season}}"><i class="fa-solid fa-dice-d20" inert></i>{{text}}</button>{{else}}<p class="hint">{{text}}</p>{{/if}}{{/each}}
            </div>
            {{/with}}
            {{/if}}
            {{#if quest}}
            {{#with quest}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Quest.Heading"}}</h4>
            <p class="detail-variant-line">{{cost}}</p>
            <p class="detail-variant-line">{{assembly}}</p>
            {{#if hint}}<p class="hint">{{hint}}</p>{{/if}}
            {{#if outcome}}<p class="detail-variant-line">{{outcome}}</p>{{/if}}
            <ul class="detail-list detail-quest">
                {{#each components}}
                <li class="{{#if found}}found{{/if}}">
                    <span>{{label}} · {{threat}}</span>
                    <span class="by">{{#if found}}{{found}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Quest.NotFound"}}{{/if}}</span>
                    {{#if over}}<span class="chip warn">{{over}}</span>{{/if}}
                    {{#if canMark}}<button type="button" class="small primary" data-action="variant" data-op="found" data-component="{{id}}">{{localize "pf2e-artisans-workshop.Variant.Quest.MarkFound"}}</button>{{/if}}
                    {{#if canUnmark}}<button type="button" class="small" data-action="variant" data-op="unfound" data-component="{{id}}">{{localize "pf2e-artisans-workshop.Variant.Quest.Unmark"}}</button>{{/if}}
                    {{#if canEdit}}<button type="button" class="small" data-action="variant" data-op="component" data-component="{{id}}">{{localize "pf2e-artisans-workshop.Variant.Quest.EditComponent"}}</button>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{#if canConfigure}}<div class="detail-actions"><button type="button" data-action="variant" data-op="quest-config"><i class="fa-solid fa-compass" inert></i>{{localize "pf2e-artisans-workshop.Variant.Quest.Configure"}}</button></div>{{/if}}
            {{/with}}
            {{/if}}
            {{#if adjustments}}
            <h4>{{localize "pf2e-artisans-workshop.Variant.Adjustments.Heading"}}</h4>
            <ul class="detail-list">{{#each adjustments}}<li>{{this}}</li>{{/each}}</ul>
            {{/if}}
            {{#if bestow}}<p class="detail-variant-line"><i class="fa-solid fa-gift" inert></i> {{bestow}}</p>{{/if}}
            {{#if note}}
            {{#if note.ask}}<p class="detail-variant-line">{{note.ask}}</p>{{/if}}
            {{#if note.text}}<p class="detail-notes">{{note.text}}</p>{{/if}}
            {{#if note.can}}<div class="detail-actions"><button type="button" data-action="variant" data-op="note"><i class="fa-solid fa-pen" inert></i>{{localize "pf2e-artisans-workshop.Variant.NoteTitle"}}</button></div>{{/if}}
            {{/if}}
            </section>
            {{/with}}
            {{/if}}
            {{/with}}
            {{#if helpers}}{{#if (or helpers.list.length helpers.canJoin)}}
            <h4>{{localize "pf2e-artisans-workshop.Helper.Heading"}}</h4>
            {{#if helpers.list.length}}
            <ul class="detail-list detail-helpers">
                {{#each helpers.list}}
                <li class="helper{{#if left}} left{{/if}}">
                    <span>{{#if rank}}{{localize "pf2e-artisans-workshop.Helper.LineRank" name=name skill=skill rank=rank}}{{else}}{{localize "pf2e-artisans-workshop.Helper.Line" name=name skill=skill}}{{/if}}</span>
                    {{#if degreeText}}<span class="fact degree {{degreeClass}}">{{localize "pf2e-artisans-workshop.Queue.Check" degree=degreeText}}</span>{{/if}}
                    {{#if rate}}<span class="fact">{{localize "pf2e-artisans-workshop.Helper.Rate" amount=rate}}</span>{{/if}}
                    {{#if waiting}}<span class="chip warn">{{localize "pf2e-artisans-workshop.Helper.Waiting"}}</span>{{/if}}
                    <span class="by">{{#if left}}{{#if forfeited}}{{localize "pf2e-artisans-workshop.Helper.LeftForfeit" joined=joined left=left}}{{else}}{{localize "pf2e-artisans-workshop.Helper.Left" joined=joined left=left}}{{/if}}{{else}}{{localize "pf2e-artisans-workshop.Helper.Joined" day=joined}}{{/if}}</span>
                    {{#if canRoll}}<button type="button" class="small primary" data-action="helper" data-op="roll" data-actor="{{uuid}}"><i class="fa-solid fa-dice-d20" inert></i>{{localize "pf2e-artisans-workshop.Helper.Roll"}}</button>{{/if}}
                    {{#if canAccept}}<button type="button" class="small" data-action="helper" data-op="accept" data-helper="{{id}}">{{localize "pf2e-artisans-workshop.Helper.Accept"}}</button>{{/if}}
                    {{#if canLeave}}<button type="button" class="small" data-action="helper" data-op="leave" data-actor="{{uuid}}">{{localize "pf2e-artisans-workshop.Helper.Leave"}}</button>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if helpers.canJoin}}<div class="detail-actions"><button type="button" data-action="helper" data-op="join"><i class="fa-solid fa-people-carry-box" inert></i>{{localize "pf2e-artisans-workshop.Helper.Join"}}</button></div>{{/if}}
            <p class="hint">{{#if helpers.dc}}{{localize "pf2e-artisans-workshop.Helper.RuleDc" dc=helpers.dc}}{{else}}{{localize "pf2e-artisans-workshop.Helper.Rule"}}{{/if}}</p>
            {{/if}}{{/if}}
            {{#if (or contributorsText.length stockText.length)}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Contributors"}}</h4>
            <ul class="detail-list">
                {{#each contributorsText}}<li><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
                {{#each stockText}}<li class="stock"><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if spentText.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Spent"}}</h4>
            <ul class="detail-list">
                {{#each spentText}}<li><span>{{name}}</span><span class="money">{{amount}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if showWorkRule}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.WorkDays"}}</h4>
            <p class="hint detail-work-rule">{{localize "pf2e-artisans-workshop.Detail.WorkRule"}}</p>
            {{/if}}
            {{#if workDaysText.length}}
            {{#unless showWorkRule}}<h4>{{localize "pf2e-artisans-workshop.Detail.WorkDays"}}</h4>{{/unless}}
            <ol class="detail-list detail-days">
                {{#each workDaysText}}<li>{{this}}</li>{{/each}}
            </ol>
            {{/if}}
            {{#if notes}}<h4>{{localize "pf2e-artisans-workshop.Detail.Notes"}}</h4><p class="detail-notes">{{notes}}</p>{{/if}}
            {{#if history.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.History"}}</h4>
            <ul class="detail-list">
                {{#each history}}<li><span>{{localize eventLabel}}</span><span class="by">{{localize "pf2e-artisans-workshop.Common.ByWhen" by=by when=when}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{#if rows.length}}
            <h4>{{localize "pf2e-artisans-workshop.Detail.Rows"}}</h4>
            <ul class="detail-list">
                {{#each rows}}<li class="{{#if reversed}}reversed{{/if}}"><span>{{localize kind}}{{#if actor}} {{localize "pf2e-artisans-workshop.Common.For" name=actor}}{{/if}}</span>{{#if amount}}<span class="money">{{amount}}</span>{{/if}}<span class="by">{{localize "pf2e-artisans-workshop.Common.By" by=by}}</span></li>{{/each}}
            </ul>
            {{/if}}
            {{/with}}
        </aside>
        {{/if}}
    </div>
    {{else}}
    <p class="queue-empty">{{localize "pf2e-artisans-workshop.Window.Unavailable"}}</p>
    {{/if}}
</section>
