                    {{#if canWithdraw}}<button type="button" class="small" data-action="pledgeOp" data-op="withdraw" data-pledge="{{id}}">{{localize "pf2e-artisans-workshop.Pledge.Withdraw"}}</button>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{/if}}
            <div class="detail-actions">
                {{#if supply.canPledge}}<button type="button" data-action="pledgeOp" data-op="pledge"><i class="fa-solid fa-scroll" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Pledge"}}</button>{{/if}}
                {{#if supply.canBuy}}<button type="button" data-action="pledgeOp" data-op="buy"><i class="fa-solid fa-coins" inert></i>{{localize "pf2e-artisans-workshop.Pledge.Buy"}}</button>{{/if}}
            </div>
            {{/if}}
            {{#if (or custody.length handOver.length)}}
            <h4>{{localize "pf2e-artisans-workshop.Custody.Heading"}}</h4>
            <ul class="detail-list detail-custody">
