                {{#each events.list}}
                <li class="event-{{#if open}}open{{else}}resolved{{/if}}">
                    <span>{{localize "pf2e-artisans-workshop.Variant.Event.Line" k=k day=day roll=roll text=text}}{{#if gmCore}} <a class="content-link" data-link data-uuid="{{link}}" draggable="true"><i class="fa-solid fa-book-open" inert></i>{{localize "pf2e-artisans-workshop.Variant.Event.Link"}}</a>{{/if}}</span>
                    <span class="by">{{#if open}}{{localize "pf2e-artisans-workshop.Variant.Event.Open"}}{{else}}{{localize "pf2e-artisans-workshop.Variant.Event.Resolved"}}{{/if}}{{#if note}} · {{note}}{{/if}}</span>
                    {{#if canResolve}}<button type="button" class="small" data-action="variant" data-op="resolve-event" data-slot="{{slot}}">{{localize "pf2e-artisans-workshop.Variant.Event.Resolve"}}</button>{{/if}}
                </li>
                {{/each}}
            </ul>
            {{/if}}
            {{#if events.pauses}}<p class="hint">{{localize "pf2e-artisans-workshop.Variant.Event.Pauses"}}</p>{{/if}}
